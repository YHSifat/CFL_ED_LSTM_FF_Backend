# Copy to .env and fill in. Never commit .env.
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# FFWC API (value of the x-ffwc-internal-key header the site sends)
FFWC_API_KEY=
FFWC_API_BASE=https://api.ffwc.gov.bd/data_load
REQUEST_DELAY_S=3
# Optional station-list endpoints (otherwise import wl_stations.json / rainfall_stations.json)
FFWC_WL_STATIONS_URL=
FFWC_RF_STATIONS_URL=

# Clustered FL LSTM checkpoint used by forecaster.py (relative to flood-engine/)
MODEL_PATH=models/clustered_fl_vanilla_lstm-local-weighted-0.5.pt
MAX_WL_INTERP_STEPS=10
